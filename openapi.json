              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "Events",
        "operationId": "events_events_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Events Events Get"
                }
              }
            }
          }
        }
      }
    },
    "/traceability": {
      "get": {
        "summary": "Traceability",
        "operationId": "traceability_traceability_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Traceability Traceability Get"
                }
              }
            }
          }
        }
      }
    },
    "/cases/reset": {
      "delete": {
        "summary": "Reset Demo",
        "operationId": "reset_demo_cases_reset_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Reset Demo Cases Reset Delete"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommercialAction": {
        "type": "string",
        "enum": [
          "DESCUENTO",
          "BANDEO",
          "PROMOCION",
          "RETIRO",
          "PENDIENTE"
        ],
        "title": "CommercialAction"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RegisterCaseRequest": {
        "properties": {
          "store": {
            "type": "string",
            "minLength": 1,
            "title": "Store"
          },
          "product_name": {
            "type": "string",
            "minLength": 1,
            "title": "Product Name"
          },
          "batch": {
            "type": "string",
            "minLength": 1,
            "title": "Batch"
          },
          "expiration_date": {
            "type": "string",
            "format": "date",
            "title": "Expiration Date"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          },
          "current_price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Current Price"
          },
          "new_price": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "New Price"
          },
          "commercial_action": {
            "$ref": "#/components/schemas/CommercialAction"
          },
          "price_change_approved": {
            "type": "boolean",
            "title": "Price Change Approved",
            "default": false
          },
          "price_change_reason": {
            "type": "string",
            "title": "Price Change Reason",
            "default": ""
          },
          "evidence_note": {
            "type": "string",
            "title": "Evidence Note",
            "default": ""
          },
          "evidence_photo_name": {
            "type": "string",
            "title": "Evidence Photo Name",
            "default": ""
          },
          "evidence_photo_data": {
            "type": "string",
            "title": "Evidence Photo Data",
            "default": ""
          },
          "created_by": {
            "type": "string",
            "title": "Created By",
            "default": "mercaderista.demo"
          }
        },
        "type": "object",
        "required": [
          "store",
          "product_name",
          "batch",
          "expiration_date",
          "quantity",
          "current_price",
          "commercial_action"
        ],
        "title": "RegisterCaseRequest"
      },
      "ValidateCaseRequest": {
        "properties": {
          "supervisor_user": {
            "type": "string",
            "minLength": 1,
            "title": "Supervisor User"
          },
          "decision": {
            "type": "string",
            "title": "Decision",
            "default": "APROBADO"
          },
          "comment": {
            "type": "string",
            "title": "Comment",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "supervisor_user"
        ],
        "title": "ValidateCaseRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
